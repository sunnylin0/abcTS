{
  "environment": "node",
  "mode": "auto",
  "targetClasses": [
	"ABCLayout",
	"AbcParse",
	"AbcTokenizer",
	"AbcTune",
	"ABCPrinter"
  ],
  "excludeMethods": [
    "toString",
    "valueOf",
    "toJSON",
    "constructor"
  ],
  "includePrivate": false,
  "maxDepth": 3,
  "maxArrayLength": 20,
  "maxStringLength": 500,
  "circularMarker": "__circular__",
  "samplingRate": 1,
  "maxCallCount": 200,
  "flushInterval": 5000,
  "outputDir": "./fun-tracer-output",
  "outputFormats": [
    "jsonl",
    "tree"
  ],
  "compareStrategy": "by-name",
  "floatPrecision": 4,
  "ignoreKeys": [],
  "reportFormat": [
    "terminal",
    "markdown",
    "html"
  ],
  "reportDir": "./fun-tracer-reports",
  "maxDiffDisplay": 50,
  "logServerPort": 3001
}