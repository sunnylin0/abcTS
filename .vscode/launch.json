{
	"version": "0.2.0",
	"configurations": [
		{
			"type": "chrome",
			"request": "launch",
			"name": "localhost (Chrome)",
			"url": "http://localhost:60000/src/workspace.html",
			"webRoot": "${workspaceFolder}"
		},
		{
			"type": "node",
			"request": "launch",
			"name": "Launch Program",
			"skipFiles": [ "<node_internals>/**" ],
			"program": "${workspaceFolder}/src/index.ts",
			"cwd": "${workspaceFolder}",
			"console": "externalTerminal"
		}
	]
}